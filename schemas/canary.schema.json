{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairox.local/schemas/canary.schema.json",
  "$comment": "DRAFT - pending M1 sign-off on canary types and real canary information. Not a frozen contract.",
  "title": "KAIROX Canary Asset",
  "description": "A decoy file or directory monitored by KAIROX.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "canary_id": { "type": "string", "format": "uuid" },
    "canary_path": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "triggered", "missing"] },
    "origin": {
      "type": "string",
      "enum": ["demo", "real"],
      "description": "Identifies whether this canary is simulated or actually deployed."
    },
    "name": { "type": ["string", "null"] },
    "volume": { "type": ["string", "null"] },
    "type": { "type": ["string", "null"] },
    "last_trigger": { "type": ["string", "null"], "format": "date-time" },
    "trigger_count": { "type": "integer", "minimum": 0, "default": 0 },
    "node_id": { "type": ["string", "null"] }
  },
  "required": ["schema_version", "canary_id", "canary_path", "created_at", "status", "origin", "name", "volume", "type", "last_trigger", "trigger_count", "node_id"]
}
