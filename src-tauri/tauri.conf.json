{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KAIROX",
  "version": "0.2.0",
  "identifier": "com.kairox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KAIROX — Endpoint Intelligence",
        "width": 1680,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#050a11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
